return function(R)
	local n = 0
	local function check(v) n += 1; assert(v, "Encounter rule failed") end
	check(R.active(true, 3, "Encounter", false, ""))
	check(not R.active(true, 3, "Puzzle", false, "") and not R.active(true, 3, "Reward", false, ""), "sentinel only acts in room 2")
	check(R.BlocksToClear == 2)
	check(not R.active(false, 3, "Encounter", false, ""))
	check(not R.active(true, 2, "Encounter", false, ""))
	check(not R.active(true, 3, "Reward", false, ""))
	check(not R.active(true, 3, "Encounter", true, ""))
	check(not R.active(true, 3, "Encounter", false, "DungeonPuzzle"))
	check(R.inside(8, 8, -8))
	check(not R.inside(8.1, 0, 0))
	check(not R.inside(0, 8.1, 0))
	check(not R.inside(0, 0, -8.1))
	local phase, deadline, hit = R.step("Ready", 0, 10, true, true)
	check(phase == "Warning" and deadline == 11.5 and not hit)
	phase, deadline, hit = R.step(phase, deadline, 11, true, true)
	check(phase == "Warning" and not hit)
	phase, deadline, hit = R.step(phase, deadline, 11.5, true, true)
	check(phase == "Rest" and hit)
	phase, deadline, hit = R.step(phase, deadline, 11.6, true, true)
	check(phase == "Rest" and not hit)
	phase, deadline, hit = R.step(phase, deadline, 14.5, true, true)
	check(phase == "Ready" and not hit)
	phase, deadline, hit = R.step("Warning", 2, 2, true, false)
	check(phase == "Rest" and not hit)
	phase, deadline, hit = R.step("Warning", 2, 2, false, true)
	check(phase == "Ready" and deadline == 0 and not hit)
	phase, deadline, hit = R.step("Ready", 0, 1000, true, true)
	check(phase == "Warning" and deadline == 1001.5 and not hit)
	check(R.canStartControl(true, 3, "Encounter", false, "Rest", false))
	for _, phase in {"Ready", "Warning", "Cleared"} do check(not R.canStartControl(true, 3, "Encounter", false, phase, false)) end
	check(not R.canStartControl(true, 3, "Encounter", true, "Rest", false))
	check(not R.canStartControl(true, 3, "Encounter", false, "Rest", true))
	check(R.canClear(true, 3, "Encounter", false, "SentinelControl", false))
	check(not R.canClear(true, 3, "Encounter", false, "DungeonPuzzle", false))
	check(not R.canClear(true, 3, "Encounter", false, "SentinelControl", true))
	check(not R.canClear(true, 3, "Reward", false, "SentinelControl", false))
	check(not R.canClear(false, 3, "Encounter", false, "SentinelControl", false))
	check(not R.canClear(true, 3, "Encounter", true, "SentinelControl", false))
	-- Role 2: caster locks a lane, warns, then fires; leaving the lane dodges.
	local phase, deadline, lane, shot = R.casterStep("Idle", 0, 0, 10, true, 300)
	check(phase == "Cooldown" and deadline == 10 + R.CasterFirstDelay and not shot)
	phase, deadline, lane, shot = R.casterStep(phase, deadline, lane, deadline, true, 304)
	check(phase == "Warning" and lane == 304 and deadline == 12 + R.CasterWarning, "warning locks the current lane")
	local strike = deadline
	check(select(4, R.casterStep(phase, deadline, lane, strike, true, 304 + R.LaneHalfWidth)), "edge of lane is hit")
	check(not select(4, R.casterStep(phase, deadline, lane, strike, true, 304 + R.LaneHalfWidth + 0.5)), "stepping out of lane dodges")
	phase, deadline, lane, shot = R.casterStep(phase, deadline, lane, strike, true, 304)
	check(phase == "Cooldown" and deadline == strike + R.CasterInterval and shot)
	check(select(1, R.casterStep("Warning", 99, 304, 98, false, 304)) == "Idle", "leaving the room resets the caster")
	check(not select(4, R.casterStep("Warning", 99, 304, 99, false, 304)), "inactive caster never fires")
	local hw, depth = R.CasterRoomHalfWidth, R.CasterRoomDepth
	check(R.inCasterRoom(0, 0) and R.inCasterRoom(hw, depth) and not R.inCasterRoom(hw + 1, 10) and not R.inCasterRoom(0, -1) and not R.inCasterRoom(0, depth + 1))
	-- Role 3: shade blocks until revealed, in room 2 only.
	check(R.shadeActive(true, 3, "Encounter", false, false) and R.shadeActive(true, 3, "Reward", false, nil))
	for _, state in {"Puzzle", "Complete", "Idle"} do check(not R.shadeActive(true, 3, state, false, false), "shade lives in room 2") end
	check(not R.shadeActive(true, 3, "Reward", false, true) and not R.shadeActive(true, 3, "Reward", true, false) and not R.shadeActive(false, 3, "Reward", false, false))
	check(R.nearShade(0, R.ShadeRadius) and not R.nearShade(R.ShadeRadius, 1))
	print(`PASS: {n} encounter checks`)
end
