--!strict
-- Read-only presentation derived from the server's replicated stage.
local Model = {}
function Model.describe(ready: boolean, stage: any): {string}
	if not ready then
		return {"กำลังรอข้อมูลนักเรียน", "ยังไม่แสดงรายการที่ได้รับจนกว่าโหลดข้อมูลสำเร็จ"}
	end
	if type(stage) ~= "number" or stage % 1 ~= 0 or stage < 0 or stage > 3 then
		return {"ข้อมูลบทเรียนไม่ถูกต้อง", "ยังไม่สามารถแสดงความก้าวหน้าได้"}
	end
	local nextSteps = {
		[0] = "ไปแท่นฝึกสีม่วง ยกผลึกให้ตรงระดับเป้าหมายแล้ววาง",
		[1] = "ไปกลไกสีฟ้า แล้วใช้แรงลอยตัววางผลึกให้ตรงเป้าหมาย",
		[2] = "ไปรับบันทึกการเรียนที่แท่นสีทอง",
		[3] = "จบบททดลองแล้ว เก็บบันทึกแรงลอยตัวไว้ในสมุดได้",
	}
	return {
		`ความก้าวหน้าบทเรียน {stage}/3`,
		if stage >= 1 then "เวทแรงลอยตัว — ปลดล็อกแล้ว\nใช้ยกและลดระดับผลึกที่แท่นฝึกหรือกลไก" else "เวทแรงลอยตัว — ยังไม่ปลดล็อก\nผ่านบทฝึกที่แท่นสีม่วงเพื่อรับเวทแน่นอน",
		if stage >= 3 then "บันทึกแรงลอยตัว — ได้รับแล้ว 1 รายการ\nฉันยกผลึกและนำเวทไปใช้กับกลไกได้สำเร็จ" else "บันทึกแรงลอยตัว — ยังไม่ได้รับ\nผ่านกลไกสีฟ้า แล้วรับจากแท่นสีทอง",
		`เป้าหมายถัดไป\n{nextSteps[stage]}`,
	}
end
return Model
